# 复制为 .env.local 后填写。切勿提交真实密钥。

# ---- 数据库（PostgreSQL + pgvector）----
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password

# ---- 会话密钥（必填）----
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# ---- 模型供应商 ----
# 硅基流动：云端 Embedding（1024 维）+ 默认 LLM
SILICONFLOW_API_KEY=
# DeepSeek：未配置硅基流动时的兜底
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com

# ---- 可选：本地 embedding 模型镜像 ----
# HF_ENDPOINT=https://hf-mirror.com

# ---- 配额与成本（可选，括号内为默认值）----
# CHAT_DAILY_LIMIT_PER_USER=300
# CHAT_DAILY_LIMIT_GLOBAL=1000
# LLM_PRICE_INPUT_PER_M=0
# LLM_PRICE_OUTPUT_PER_M=0
